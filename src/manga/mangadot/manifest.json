{
  "id": "dipland-mangadot",
  "name": "MangaDot",
  "version": "1.1.0",
  "manifestURI": "https://raw.githubusercontent.com/Pal-droid/Seanime-Providers/main/src/manga/mangadot/manifest.json",
  "language": "typescript",
  "type": "manga-provider",
  "description": "Multi language manga provider.",
  "author": "dip-land",
  "icon": "https://raw.githubusercontent.com/pal-droid/seanime-providers/refs/heads/main/public/mangadot.png",
  "website": "https://mangadot.net/",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/Pal-droid/Seanime-Providers/main/src/manga/mangadot/provider.ts",
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "solver",
        "label": "Solver",
        "type": "select",
        "default": "dipped.dev",
        "options": [
          {
            "label": "mangaproxy.dipped.dev",
            "value": "mpdp"
          },
          {
            "label": "Custom",
            "value": "custom"
          }
        ]
      },
      {
        "name": "custom_solver",
        "label": "Custom Solver URL",
        "type": "switch",
        "default": "http://127.0.0.1:8191"
      }
    ]
  }
}
