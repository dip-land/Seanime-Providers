{
  "id": "dipland-mangaball",
  "name": "MangaBall",
  "version": "1.1.0",
  "manifestURI": "https://raw.githubusercontent.com/dip-land/seanime-providers/solver_update/src/manga/mangaball/manifest_dev.json",
  "language": "typescript",
  "type": "manga-provider",
  "description": "Multi language manga provider.",
  "author": "dip-land",
  "icon": "https://raw.githubusercontent.com/dip-land/seanime-providers/refs/heads/solver_update/public/mangaball.png",
  "website": "https://mangaball.net/",
  "lang": "multi",
  "payloadURI": "https://raw.githubusercontent.com/dip-land/seanime-providers/solver_update/src/manga/mangaball/provider.ts",
  "userConfig": {
    "requiresConfig": false,
    "version": 1,
    "fields": [
      {
        "name": "solver",
        "label": "Solver",
        "type": "select",
        "default": "mpdp",
        "options": [
          {
            "label": "mangaproxy.dipped.dev",
            "value": "mpdp"
          },
          {
            "label": "Custom",
            "value": "custom"
          }
        ]
      },
      {
        "name": "custom_solver",
        "label": "Custom Solver URL",
        "type": "switch",
        "default": "http://127.0.0.1:8191"
      }
    ]
  }
}
